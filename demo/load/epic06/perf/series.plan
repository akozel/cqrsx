# Backlog epic 06, the series «до → после»: REPEAT=3, SEED=e06s. e06s-base- = encore-load-backend:e06-base (the engine
# and the demo at a270a06 with this directory's probe, build.sh e06-base … a270a06), e06s-head- =
# encore-load-backend:e06-03 (the tree after ticket 03; ticket 08 rebuilds the head from ticket 07 and changes the tag
# here). The probe's script is ../k6/probe.js, named relative to demo/load/k6 as run.sh takes it (see series.sh). Every pass runs the twelve lines in its own order (random.Random("e06s-<pass>")), so
# «до» and «после» alternate within one session.
# Six configurations, not the nine of check.plan: the user limited a series to 40 minutes (2026-10-30). By the check
# runs one pass of the six takes about 5 minutes per image, so 2 images × 3 passes ≈ 30 minutes. Left out: 01 db
# (WAL-bound, the same path as 01 app; statements per command come from 03a), 02b (135 s, MongoDB and verify),
# 09-probe-k4-m4 (the two growths are seen apart). 09-probe-k1-m4 runs with VUS=10 KEYS=10: with 50 VUs it left
# ~390 000 tasks to drain (149 s); CPU per task does not depend on how many there are.
# Both prefixes are 10 characters: run.sh cuts the run name to 24 characters for k6's ids (RUN_SLUG), and a prefix of
# another length made the concert ids of one image a character shorter (05/13 check runs, 01-hot-key: «e05c-01-» →
# «e05c-01»).
e06s-base- e06-base hot-key NAME=01-hot-key-vus40-app VUS=40 POOL=20 PROFILE=app WORKERS=2 DRAIN=1 DRAIN_TIMEOUT=240
e06s-head- e06-03 hot-key NAME=01-hot-key-vus40-app VUS=40 POOL=20 PROFILE=app WORKERS=2 DRAIN=1 DRAIN_TIMEOUT=240
e06s-base- e06-base spread-bookings NAME=03a-drain-w8-db VUS=50 POOL=20 PROFILE=db WORKERS=8 DRAIN=1 DRAIN_TIMEOUT=240
e06s-head- e06-03 spread-bookings NAME=03a-drain-w8-db VUS=50 POOL=20 PROFILE=db WORKERS=8 DRAIN=1 DRAIN_TIMEOUT=240
e06s-base- e06-base ../epic06/k6/probe NAME=09-probe-k1-m1 VUS=50 KEYS=50 POOL=20 PROFILE=app WORKERS=8 DRAIN=1 DRAIN_TIMEOUT=200 ENCORE_LOAD_VIEWS=1 ENCORE_LOAD_TASKS=1
e06s-head- e06-03 ../epic06/k6/probe NAME=09-probe-k1-m1 VUS=50 KEYS=50 POOL=20 PROFILE=app WORKERS=8 DRAIN=1 DRAIN_TIMEOUT=200 ENCORE_LOAD_VIEWS=1 ENCORE_LOAD_TASKS=1
e06s-base- e06-base ../epic06/k6/probe NAME=09-probe-k4-m1 VUS=50 KEYS=50 POOL=20 PROFILE=app WORKERS=8 DRAIN=1 DRAIN_TIMEOUT=200 ENCORE_LOAD_VIEWS=4 ENCORE_LOAD_TASKS=1
e06s-head- e06-03 ../epic06/k6/probe NAME=09-probe-k4-m1 VUS=50 KEYS=50 POOL=20 PROFILE=app WORKERS=8 DRAIN=1 DRAIN_TIMEOUT=200 ENCORE_LOAD_VIEWS=4 ENCORE_LOAD_TASKS=1
e06s-base- e06-base ../epic06/k6/probe NAME=09-probe-k1-m4 VUS=10 KEYS=10 POOL=20 PROFILE=app WORKERS=8 DRAIN=1 DRAIN_TIMEOUT=200 ENCORE_LOAD_VIEWS=1 ENCORE_LOAD_TASKS=4
e06s-head- e06-03 ../epic06/k6/probe NAME=09-probe-k1-m4 VUS=10 KEYS=10 POOL=20 PROFILE=app WORKERS=8 DRAIN=1 DRAIN_TIMEOUT=200 ENCORE_LOAD_VIEWS=1 ENCORE_LOAD_TASKS=4
e06s-base- e06-base ../epic06/k6/probe NAME=09-probe-hot-k4 VUS=40 KEYS=1 POOL=20 PROFILE=app WORKERS=8 DRAIN=1 DRAIN_TIMEOUT=200 ENCORE_LOAD_VIEWS=4 ENCORE_LOAD_TASKS=1
e06s-head- e06-03 ../epic06/k6/probe NAME=09-probe-hot-k4 VUS=40 KEYS=1 POOL=20 PROFILE=app WORKERS=8 DRAIN=1 DRAIN_TIMEOUT=200 ENCORE_LOAD_VIEWS=4 ENCORE_LOAD_TASKS=1
