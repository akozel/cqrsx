# Copy to demo/.env (both binaries load it with dotenvy). Values are the defaults.
# --- back-end ---
ENCORE_DATABASE_URL=postgresql://cqrsx:cqrsx@localhost:5434/encore
ENCORE_DATABASE_POOL_SIZE=10          # PostgreSQL connections shared by HTTP, the outbox poller and the workers
ENCORE_MONGODB_URI=mongodb://localhost:27018
ENCORE_READ_DB=encore_read            # the read models (also read by the sidecar's X-ray)
ENCORE_HTTP_ADDR=127.0.0.1:8080
ENCORE_MAIL_SERVICE_URL=http://127.0.0.1:8090   # the external mail service (POST /mail); the demo's one is hosted by the sidecar
ENCORE_TASK_MAX_ATTEMPTS=6            # claim-attempt limit of the mail tasks (NewTask::with_max_attempts)
ENCORE_CHAIN_MAX_ATTEMPTS=60          # budget of the chain tasks (no chaos; only spent while a rebuild holds the lock)
ENCORE_TASK_RETRY_BASE_MS=1000        # backoff a mail task asks for after a refused delivery: 1, 2, 4, 8, 8 s
ENCORE_TASK_RETRY_MAX_MS=8000
ENCORE_TICKET_LIMIT=4                 # rule R6
ENCORE_SNAPSHOT_EVERY=10              # snapshot every N events
ENCORE_REPLAY_SLOW_DELAY_MS=80        # slow-motion replay delay per event
# cqrsx task runtime (library keys, demo defaults; lease must exceed 2*S + H + 5s + ceil(Q/C)*(H+S) = 24 s).
# A mail request gives up one second before H, so a slow provider ends in a retry, not a timed-out handler.
OUTBOX_WORKER_CONCURRENCY=2
OUTBOX_QUEUE_CAPACITY=2
OUTBOX_POLL_INTERVAL_MS=300
OUTBOX_HANDLER_TIMEOUT_SECS=5
OUTBOX_LEASE_SECS=30
OUTBOX_STORAGE_TIMEOUT_MS=3000
OUTBOX_POSTGRES_STATEMENT_TIMEOUT_MS=4000
# --- sidecar ---
SIDECAR_DATABASE_URL=postgresql://encore_inspector:inspector@localhost:5434/encore
SIDECAR_MONGODB_URI=mongodb://localhost:27018
SIDECAR_HTTP_ADDR=127.0.0.1:8090
SIDECAR_POLL_MS=400
ENCORE_MAIL_DB=mail_service           # the mail service's database: written by the sidecar's mail service, shown in the X-ray
# DEMO ONLY: the demo lifecycle lives in the sidecar, not in the back-end
SIDECAR_ADMIN_DATABASE_URL=postgresql://encore_demo_admin:demo-admin@localhost:5434/encore   # may only TRUNCATE the three tables
SIDECAR_BACKEND_URL=http://127.0.0.1:8080  # the default concerts are announced through the public API
SIDECAR_SEED=true                          # announce them at start-up (retries until the back-end is up)
SIDECAR_RESET_ENABLED=true                 # POST /inspect/reset (the ⟲ button in the UI); 🧨 wipe (POST /inspect/projections/wipe) is always allowed
# DEMO ONLY: the external mail service (POST /mail) the back-end's e-mail tasks call
SIDECAR_MAIL_FAILURE_RATE=0.2              # chance that a delivery is refused with 503 (and the task retried)
SIDECAR_MAIL_LATENCY_MIN_MS=600            # simulated network latency; keep MAX below the back-end's mail timeout (OUTBOX_HANDLER_TIMEOUT_SECS - 1 s)
SIDECAR_MAIL_LATENCY_MAX_MS=1800
SIDECAR_MAIL_CHAOS_SEED=                   # empty = random; set for deterministic dice
# --- both ---
RUST_LOG=info                         # one level only (off/error/warn/info/debug/trace)
# --- compose ---
ENCORE_POSTGRES_PORT=5434
ENCORE_MONGO_PORT=27018
