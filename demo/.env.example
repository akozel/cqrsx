# Encore demo configuration. Copy to demo/.env: both binaries load it through dotenvy, and compose reads
# the published ports from it. Every variable has a default; the commented line shows it. Uncomment a
# line to change the value.
#
# Contents
#   1. Back-end: addresses and storage
#   2. Back-end: box-office rules
#   3. Back-end: commands and read models
#   4. Back-end: outbox tasks
#   5. Sidecar: addresses and storage
#   6. Sidecar: demo lifecycle and the moody mail service (DEMO ONLY)
#   7. Both: logging
#   8. Compose: published ports

# ------------------------------------------------------------------------------------------------
# 1. Back-end: addresses and storage
# ------------------------------------------------------------------------------------------------

# Where the HTTP API listens.
# ENCORE_HTTP_ADDR=127.0.0.1:8080

# PostgreSQL: the event store, the snapshots and the outbox (role `cqrsx` owns the tables).
# ENCORE_DATABASE_URL=postgresql://cqrsx:cqrsx@localhost:5434/encore

# Connections of the main pool: HTTP commands, the task handlers' commands and the outbox queue.
# ENCORE_DATABASE_POOL_SIZE=10

# Server-side cap of every statement of the main pool, in milliseconds; 0 = no cap.
# ENCORE_DATABASE_STATEMENT_TIMEOUT_MS=4000

# Connections of the history pool, which has no cap: verify, the ledger totals and the time machine read
# whole histories through it.
# ENCORE_DATABASE_HISTORY_POOL_SIZE=1

# Connections of the projection pool, under the main pool's cap: the projection processors read the
# journal through it (pages, and on a rebuild the history of every key of a page), so Encore! never takes
# the connections of the commands.
# ENCORE_DATABASE_PROJECTION_POOL_SIZE=4

# MongoDB and the database of the read models and of their checkpoints (the sidecar's X-ray reads the
# same database).
# ENCORE_MONGODB_URI=mongodb://localhost:27018
# ENCORE_READ_DB=encore_read

# The external mail service the e-mail tasks call (POST /mail). The demo's one is hosted by the sidecar.
# ENCORE_MAIL_SERVICE_URL=http://127.0.0.1:8090

# ------------------------------------------------------------------------------------------------
# 2. Back-end: box-office rules
# ------------------------------------------------------------------------------------------------

# Tickets one fan may hold for one concert (rule R6).
# ENCORE_TICKET_LIMIT=4

# Slow-motion Encore!: the pause between the events of one concert hall or fan ledger, in milliseconds.
# The UI asks for it when "slow motion" is ticked, 0 otherwise.
# ENCORE_REPLAY_SLOW_DELAY_MS=80

# The longest pause a rebuild request may ask for, in milliseconds: a slower rebuild would hold its keys,
# and through them the whole read model, for hours.
# ENCORE_REPLAY_MAX_PACE_MS=1000

# ------------------------------------------------------------------------------------------------
# 3. Back-end: commands and read models
# ------------------------------------------------------------------------------------------------

# A snapshot of the aggregate every N events: a command loads the last snapshot and the events after it.
# ENCORE_SNAPSHOT_EVERY=10

# Commands to one concert or fan ledger run one at a time under its lock, in arrival order. A command
# waits for the lock at most this long, in milliseconds; past it the client gets 503. Keep it below
# OUTBOX_HANDLER_TIMEOUT_SECS.
# ENCORE_COMMAND_LOCK_MAX_WAIT_MS=1000

# Commands that may wait for one aggregate's lock at once; the next one gets 503 without waiting.
# ENCORE_COMMAND_LOCK_MAX_WAITERS=128

# The read models follow the journal: a projection processor per read model reads the events of its
# aggregate type page by page from a checkpoint (in ENCORE_READ_DB, next to the documents) and applies
# them through one worker per concert or fan ledger. A command answers "accepted" right after its commit
# and wakes the processor of this node; on another node the poll finds the commit.
# How often an idle processor polls the journal, in milliseconds.
# ENCORE_PROJECTION_POLL_MS=250
# Events read per page.
# ENCORE_PROJECTION_PAGE=1000
# The lease of a checkpoint, in milliseconds: one node applies a read model at a time, and after a crash
# another takes over within this long (at least 1000).
# ENCORE_PROJECTION_LEASE_MS=10000
# The pause after a failed round, in milliseconds: min(base * 2^(n-1), max).
# ENCORE_PROJECTION_RETRY_BASE_MS=500
# ENCORE_PROJECTION_RETRY_MAX_MS=10000
# Documents written at once.
# ENCORE_PROJECTION_CONCURRENCY=16
# Work waiting per concert or fan ledger (at least 2): the pages in flight are one fewer.
# ENCORE_PROJECTION_BUFFER=64
# Pages of one key applied in one call at most; 1 = no batches.
# ENCORE_PROJECTION_MAX_BATCH=32
# Keys rebuilt per page of Encore!, between the live pages.
# ENCORE_PROJECTION_REBUILD_PAGE=100
# How long a processor waits after a commit woke it before it reads the journal, in milliseconds: the commits of
# a burst then share a page, one read and one write per document instead of one per commit. 0 = read at once
# (the library's default); at most ENCORE_PROJECTION_POLL_MS. A booking reaches the screen this much later.
# ENCORE_PROJECTION_SETTLE_MS=10
# Events counted at most for the lag the status shows ("100000+" above it).
# ENCORE_PROJECTION_LAG_CAP=100000
# How long the status waits for the checkpoints, in milliseconds, before it answers with the rows it saw
# last (marked stale): a stopped MongoDB must not hang the status.
# ENCORE_PROJECTION_STATUS_TIMEOUT_MS=1000
# The owner name this process writes on the checkpoints it holds (the X-ray and the status show it).
# ENCORE_NODE_NAME=encore-backend

# ------------------------------------------------------------------------------------------------
# 4. Back-end: outbox tasks
# ------------------------------------------------------------------------------------------------

# Claim attempts of a task before it fails for good: the chain tasks between the two aggregates and the
# e-mails.
# ENCORE_TASK_MAX_ATTEMPTS=6

# Backoff an e-mail task asks for after a refused delivery, in milliseconds: min(base * 2^(n-1), max),
# i.e. 1, 2, 4, 8, 8 s with the defaults.
# ENCORE_TASK_RETRY_BASE_MS=1000
# ENCORE_TASK_RETRY_MAX_MS=8000

# The cqrsx task runtime (the library's own keys, demo defaults): C workers, Q claimed tasks waiting for
# a worker, the poll interval, the handler timeout H, the lease and the storage timeout S. The lease
# must exceed 2*S + H + 5 s + ceil(Q/C)*(H + S) = 24 s with the defaults. A mail request gives up one
# second before H, so a slow provider ends in a retry, not in a timed-out handler.
# OUTBOX_WORKER_CONCURRENCY=2
# OUTBOX_QUEUE_CAPACITY=2
# OUTBOX_POLL_INTERVAL_MS=300
# OUTBOX_HANDLER_TIMEOUT_SECS=5
# OUTBOX_LEASE_SECS=30
# OUTBOX_STORAGE_TIMEOUT_MS=3000

# ------------------------------------------------------------------------------------------------
# 5. Sidecar: addresses and storage
# ------------------------------------------------------------------------------------------------

# Where the X-ray API listens (/inspect) and the demo's mail service (POST /mail).
# SIDECAR_HTTP_ADDR=127.0.0.1:8090

# PostgreSQL through the read-only role (SELECT on events, snapshots and the outbox).
# SIDECAR_DATABASE_URL=postgresql://encore_inspector:inspector@localhost:5434/encore

# MongoDB: the read models (ENCORE_READ_DB above) and the mail service's database.
# SIDECAR_MONGODB_URI=mongodb://localhost:27018
# ENCORE_MAIL_DB=mail_service

# How often the X-ray polls both databases, in milliseconds; a change is pushed to the SSE clients.
# SIDECAR_POLL_MS=400

# ------------------------------------------------------------------------------------------------
# 6. Sidecar: demo lifecycle and the moody mail service (DEMO ONLY)
# ------------------------------------------------------------------------------------------------

# The role that may only TRUNCATE the three tables: the reset button.
# SIDECAR_ADMIN_DATABASE_URL=postgresql://encore_demo_admin:demo-admin@localhost:5434/encore

# The back-end whose public API announces the default concerts (seed and reset).
# SIDECAR_BACKEND_URL=http://127.0.0.1:8080

# Announce the default concerts at start-up (retries until the back-end is up).
# SIDECAR_SEED=true

# Expose POST /inspect/reset (the reset button in the UI); a wipe of the read models is always allowed.
# SIDECAR_RESET_ENABLED=true

# The chance that the mail service refuses a delivery with 503 (and the back-end's task is retried).
# SIDECAR_MAIL_FAILURE_RATE=0.2

# Simulated network latency of the mail service, in milliseconds. Keep the maximum below the back-end's
# mail request timeout: OUTBOX_HANDLER_TIMEOUT_SECS minus one second.
# SIDECAR_MAIL_LATENCY_MIN_MS=600
# SIDECAR_MAIL_LATENCY_MAX_MS=1800

# Unset or empty = random dice; a number makes the refusals deterministic.
# SIDECAR_MAIL_CHAOS_SEED=

# ------------------------------------------------------------------------------------------------
# 7. Both: logging
# ------------------------------------------------------------------------------------------------

# One level for both binaries: off, error, warn, info, debug or trace (not a directive list).
# RUST_LOG=info

# ------------------------------------------------------------------------------------------------
# 8. Compose: published ports
# ------------------------------------------------------------------------------------------------

# The host ports of the PostgreSQL and MongoDB containers (the defaults avoid the root compose on 5433).
# ENCORE_POSTGRES_PORT=5434
# ENCORE_MONGO_PORT=27018
