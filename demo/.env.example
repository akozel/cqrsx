# Copy to demo/.env (both binaries load it with dotenvy). Values are the defaults.

# --- back-end ---
ENCORE_DATABASE_URL=postgresql://cqrsx:cqrsx@localhost:5434/encore
ENCORE_MONGODB_URI=mongodb://localhost:27018
ENCORE_READ_DB=encore_read
ENCORE_MAIL_DB=mail_service
ENCORE_HTTP_ADDR=127.0.0.1:8080
ENCORE_TASK_FAILURE_RATE=0.2          # DEMO ONLY: chance that the mail server "fails" and the task is retried
ENCORE_TASK_LATENCY_MIN_MS=600        # simulated network latency of the mail server
ENCORE_TASK_LATENCY_MAX_MS=1800
ENCORE_TASK_MAX_ATTEMPTS=6            # claim-attempt limit per task (NewTask::with_max_attempts)
ENCORE_TASK_RETRY_BASE_MS=1000        # mail task backoff via retry_after: 1, 2, 4, 8, 8 s
ENCORE_TASK_RETRY_MAX_MS=8000
ENCORE_CHAOS_SEED=                    # empty = random; set for deterministic chaos
ENCORE_TICKET_LIMIT=4                 # rule R6
ENCORE_SNAPSHOT_EVERY=10              # snapshot every N events
ENCORE_REPLAY_SLOW_DELAY_MS=80        # slow-motion replay delay per event
ENCORE_SEED=true                      # announce the three default concerts at start-up

# cqrsx task runtime (library keys, demo defaults; lease must exceed 2*S + H + 5s + ceil(Q/C)*(H+S) = 24 s)
OUTBOX_WORKER_CONCURRENCY=2
OUTBOX_QUEUE_CAPACITY=2
OUTBOX_POLL_INTERVAL_MS=300
OUTBOX_HANDLER_TIMEOUT_SECS=5
OUTBOX_LEASE_SECS=30
OUTBOX_STORAGE_TIMEOUT_MS=3000
OUTBOX_POSTGRES_STATEMENT_TIMEOUT_MS=4000

# --- sidecar ---
SIDECAR_DATABASE_URL=postgresql://encore_inspector:inspector@localhost:5434/encore
SIDECAR_MONGODB_URI=mongodb://localhost:27018
SIDECAR_HTTP_ADDR=127.0.0.1:8090
SIDECAR_POLL_MS=400

# --- both ---
RUST_LOG=info                         # one level only (off/error/warn/info/debug/trace)

# --- compose ---
ENCORE_POSTGRES_PORT=5434
ENCORE_MONGO_PORT=27018
